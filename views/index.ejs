</div>

</div>

</div>

<!-- FOOTER -->

<div class="footer">
©  PolyKatni PYQ's Portal
</div>

<!-- JS -->

<script>

/* NAV TOGGLE */

const menuToggle = document.getElementById("menuToggle");
const navLinks = document.getElementById("navLinks");

menuToggle.addEventListener("click", () => {
navLinks.classList.toggle("active");
});

/* OPTIONAL DYNAMIC DATA */

document.getElementById("papers").textContent = "120+";
document.getElementById("subjects").textContent = "35+";
document.getElementById("updated").textContent = "Mar 2026";

</script>

</body>
</html>