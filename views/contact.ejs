<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Contact | PolyKatni PYQ's Portal</title>
<link rel="icon" href="/images/logo.jpg" type="image/jpg">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Segoe UI',sans-serif;
}

.logo{
display:flex;
align-items:center;
gap:10px;
font-weight:600;
color:white;
}

.logo img{
height:40px;
width:40px;
object-fit:contain;
border-radius:6px;
}

.logo span{
font-size:16px;
}

body{
min-height:100vh;
background:linear-gradient(120deg,#0f172a,#1e3a8a);
overflow-x:hidden;
color:white;
}

/* ANIMATED BACKGROUND */

.background{
position:fixed;
width:100%;
height:100%;
top:0;
left:0;
z-index:-1;
overflow:hidden;
}

.blob{
position:absolute;
width:400px;
height:400px;
background:radial-gradient(circle,#3b82f6,transparent);
filter:blur(100px);
opacity:0.5;
animation:float 12s infinite linear;
}

.blob:nth-child(1){
top:10%;
left:10%;
}

.blob:nth-child(2){
top:60%;
right:10%;
animation-duration:18s;
}

@keyframes float{
0%{transform:translateY(0)}
50%{transform:translateY(-60px)}
100%{transform:translateY(0)}
}

/* NAVBAR */

nav{
background:#1f2a44;
padding:15px 60px;
display:flex;
justify-content:space-between;
align-items:center;

/* 🔥 FIX */
position:sticky;
top:0;
z-index:1000;
}

.logo{
font-weight:600;
}

/* 🔥 UPDATED NAV */

.nav-links{
display:flex;
align-items:center;
transition:max-height 0.3s ease;
}

.nav-links a{
color:white;
text-decoration:none;
margin-left:20px;
font-size:14px;
}

.nav-links a:hover{
opacity:0.8;
}

.menu-toggle{
display:none;
color:white;
font-size:24px;
cursor:pointer;
}

/* MOBILE RESPONSIVE */

@media (max-width:768px){

nav{
padding:15px 20px;
flex-wrap:wrap;
position:relative;
}

.logo{
width:100%;
text-align:center;
justify-content:center;
}

/* 🔥 LEFT TOGGLE */
.menu-toggle{
display:block;
position:absolute;
left:20px;
top:15px;
}

/* 🔥 CENTER LOGO */
.logo{
width:100%;
text-align:center;
}

/* 🔥 FIXED MENU */
.nav-links{
width:100%;
flex-direction:column;
align-items:center;
max-height:0;
overflow:hidden;
}

.nav-links.active{
max-height:300px;
}

.nav-links a{
margin:10px 0;
}

}

/* HERO */

.hero{
text-align:center;
padding:70px 20px;
}

.hero h1{
font-size:38px;
margin-bottom:10px;
}

.hero p{
opacity:0.8;
}

/* CONTAINER */

.container{
max-width:1100px;
margin:auto;
padding:40px 20px;
}

/* DEVELOPER GRID */

.dev-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:30px;
}

/* CARD */

.card{
background:rgba(255,255,255,0.05);
backdrop-filter:blur(20px);
border:1px solid rgba(255,255,255,0.1);
border-radius:18px;
padding:35px;
text-align:center;

opacity:0;
transform:translateY(40px);
transition:0.6s;
}

.card.show{
opacity:1;
transform:translateY(0);
}

.card:hover{
transform:translateY(-8px);
border-color:#3b82f6;
}

.card img{
width:120px;
height:120px;
border-radius:50%;
object-fit:cover;
margin-bottom:12px;
border:3px solid #3b82f6;
}

.role{
color:#93c5fd;
font-size:14px;
margin:6px 0;
}

.location{
font-size:13px;
opacity:0.8;
margin-bottom:15px;
}

/* SOCIAL */

.social{
display:flex;
justify-content:center;
gap:12px;
}

.social a{
width:40px;
height:40px;
display:flex;
align-items:center;
justify-content:center;
border-radius:50%;
font-size:16px;
color:white;
transition:0.3s;
}

.gmail{background:#d44638;}
.insta{background:#e1306c;}
.github{background:#333;}
.linkedin{background:#0077b5;}

.social a:hover{
transform:scale(1.2);
}

/* COLLEGE SECTION */

.college{
margin-top:70px;
background:rgba(255,255,255,0.05);
backdrop-filter:blur(20px);
border:1px solid rgba(255,255,255,0.1);
padding:35px;
border-radius:18px;
text-align:center;

opacity:0;
transform:translateY(40px);
transition:0.6s;
}

.college.show{
opacity:1;
transform:translateY(0);
}

/* FOOTER */

.footer{
text-align:center;
padding:25px;
margin-top:50px;
opacity:0.7;
}

</style>
</head>

