<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Delete Papers | PolyKatni PYQ's Portal</title>

<link rel="icon" href="/images/logo.jpg" type="image/jpg">

<style>

/* RESET */
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Segoe UI',sans-serif;
}

/* BODY */
body{
background-color:#e3f2fd;
display:flex;
flex-direction:column;
min-height:100vh;
}

/* NAVBAR */
nav{
background:#1f2a44;
color:white;
padding:15px 80px;
display:flex;
justify-content:space-between;
align-items:center;
position:sticky;
top:0;
z-index:1000;
}

/* LOGO */
.logo{
display:flex;
align-items:center;
gap:12px;
font-weight:600;
}

.logo img{
width:40px;
height:40px;
border-radius:8px;
object-fit:cover;
}

/* MENU */
.nav-menu{
display:flex;
list-style:none;
align-items:center;
}

.nav-menu li a{
position:relative;
color:white;
text-decoration:none;
margin-left:30px;
font-size:14px;
padding-bottom:5px;
}

/* HOVER ANIMATION */
.nav-menu li a::after{
content:"";
position:absolute;
left:0;
bottom:0;
width:0%;
height:2px;
background:#3b82f6;
transition:0.3s;
}

.nav-menu li a:hover::after{
width:100%;
}

.logout{
color:#ff6b6b;
}

/* TOGGLE */
.menu-toggle{
display:none;
font-size:24px;
cursor:pointer;
}

/* MOBILE */
@media (max-width:768px){

nav{
padding:15px 20px;
flex-wrap:wrap;
position:relative;
}

.menu-toggle{
display:block;
position:absolute;
left:20px;
top:15px;
}

.logo{
width:100%;
justify-content:center;
margin-bottom:10px;
}

.nav-menu{
width:100%;
flex-direction:column;
align-items:center;
max-height:0;
overflow:hidden;
transition:0.3s;
}

.nav-menu.active{
max-height:300px;
}

.nav-menu li{
margin:10px 0;
}

.nav-menu li a{
margin-left:0;
}

}

/* ================= LOGOUT MODAL ================= */

.logout-modal{
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:rgba(0,0,0,0.4);
backdrop-filter:blur(8px);
display:flex;
justify-content:center;
align-items:center;
opacity:0;
pointer-events:none;
transition:0.3s;
z-index:2000;
}

.logout-modal.active{
opacity:1;
pointer-events:auto;
}

.modal-box{
background:rgba(255,255,255,0.1);
border:1px solid rgba(255,255,255,0.2);
backdrop-filter:blur(20px);
padding:25px;
border-radius:16px;
text-align:center;
width:320px;
color:white;
animation:scaleUp 0.3s ease;
}

@keyframes scaleUp{
from{transform:scale(0.8); opacity:0;}
to{transform:scale(1); opacity:1;}
}

.modal-box h3{
margin-bottom:10px;
}

.modal-box p{
font-size:14px;
margin-bottom:20px;
opacity:0.8;
}

.modal-buttons{
display:flex;
gap:10px;
}

.cancel-btn{
flex:1;
padding:10px;
border:none;
background:#94a3b8;
border-radius:6px;
cursor:pointer;
}

.confirm-btn{
flex:1;
padding:10px;
text-decoration:none;
text-align:center;
background:#ef4444;
color:white;
border-radius:6px;
}

.cancel-btn:hover{
background:#64748b;
}

.confirm-btn:hover{
background:#dc2626;
}

/* MAIN */

.main{
flex:1;
display:flex;
justify-content:center;
align-items:center;
}

/* DELETE CARD */

.delete-card{
background:#ffffff;
padding:2.5rem;
border-radius:12px;
box-shadow:0 10px 25px rgba(0, 86, 179, 0.1);
text-align:center;
width:100%;
max-width:350px;
border-top:5px solid #1976d2;
}

h1{
font-size:1.5rem;
color:#0d47a1;
margin-bottom:0.5rem;
}

p{
color:#546e7a;
font-size:0.9rem;
margin-bottom:1.5rem;
}

input[type="number"]{
width:100%;
padding:12px;
margin-bottom:1.2rem;
border:1px solid #bbdefb;
border-radius:6px;
font-size:1rem;
outline:none;
}

input[type="number"]:focus{
border-color:#1976d2;
}

.btn-delete{
width:100%;
padding:12px;
background-color:#d93025;
color:white;
border:none;
border-radius:6px;
font-size:1rem;
font-weight:600;
cursor:pointer;
transition:0.2s;
}

.btn-delete:hover{
background-color:#b31412;
}

</style>

</head>

<body>

<!-- NAVBAR -->
<nav>

<div class="menu-toggle" id="menuToggle">☰</div>

<div class="logo">
<img src="/images/logo.jpg" alt="Logo">
<span>PolyKatni PYQ's</span>
</div>

<ul class="nav-menu" id="navMenu">
<li><a href="/home">Home</a></li>
<li><a href="/UploadPage">Upload Papers</a></li>
<li><a href="/delete">Delete Papers</a></li>
<li><a href="#" id="logoutBtn" class="logout">Log out</a></li>
</ul>

</nav>

<!-- LOGOUT MODAL -->
<div class="logout-modal" id="logoutModal">
  <div class="modal-box">
    <h3>⚠️ Confirm Logout</h3>
    <p>Are you sure you want to log out of admin panel?</p>

    <div class="modal-buttons">
      <button class="cancel-btn" id="cancelLogout">Cancel</button>
      <a href="/logout" class="confirm-btn">Yes, Logout</a>
    </div>
  </div>
</div>

<!-- MAIN -->
<div class="main">

<div class="delete-card">

<h1>Delete Papers</h1>
<p>Enter a year to remove all associated records.</p>

<form action="/deletePapers" method="POST">

<input type="number" 
name="year" 
placeholder="Enter Year (e.g. 2024)" 
min="2010">

<button type="submit" class="btn-delete">
Delete All Papers
</button>

</form>

</div>

</div>

<!-- NAV TOGGLE JS -->
<script>
const menuToggle = document.getElementById("menuToggle");
const navMenu = document.getElementById("navMenu");

menuToggle.addEventListener("click", ()=>{
navMenu.classList.toggle("active");
});
</script>

<!-- 🔥 LOGOUT MODAL JS -->
<script>
const logoutBtn = document.getElementById("logoutBtn");
const logoutModal = document.getElementById("logoutModal");
const cancelLogout = document.getElementById("cancelLogout");

logoutBtn.addEventListener("click", (e)=>{
e.preventDefault();
logoutModal.classList.add("active");
});

cancelLogout.addEventListener("click", ()=>{
logoutModal.classList.remove("active");
});

logoutModal.addEventListener("click", (e)=>{
if(e.target === logoutModal){
logoutModal.classList.remove("active");
}
});
</script>

</body>
</html>